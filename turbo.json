{
  "$schema": "https://v2-11-5.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "index": {
      "outputs": ["src/index.ts"]
    },
    "pre-build": {
      "outputs": ["dist/**", "build/**"]
    },
    "build": {
      "dependsOn": ["license", "^index", "^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
    },
    "check": {
      "description": "Run Biome code quality checks (lint + format + organize imports)",
      "dependsOn": ["license", "^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", ".biomerc*", "biome.json"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "constellation-tracker": {
      "cache": false
    },
    "lint": {},
    "lint:package": {},
    "license": {
      "cache": false,
      "dependsOn": ["index"]
    },
    "format": {
      "cache": false,
      "dependsOn": ["license"]
    },
    "format:check": {
      "cache": false,
      "dependsOn": ["license"]
    },
    "context": {
      "dependsOn": ["index"]
    },
    "bench": {
      "dependsOn": ["^build"]
    }
  }
}
